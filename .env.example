# Copy to .env for local development: cp .env.example .env
# Never commit .env — it holds secrets. See README for details.

# Django secret key. REQUIRED in production; generate a long random value.
# Locally you can leave this unset (a dev-only default is used).
DJANGO_SECRET_KEY=

# Set to False in production. Defaults to True (local development).
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the site when DEBUG is False.
# Defaults to .vercel.app,localhost,127.0.0.1 — set your own domain in production.
ALLOWED_HOSTS=

# Comma-separated origins allowed to POST forms over HTTPS.
# Defaults to https://*.vercel.app — narrow it to your exact domain in production.
CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection string. When set, the app uses Postgres;
# when unset, it falls back to local SQLite (db.sqlite3).
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
